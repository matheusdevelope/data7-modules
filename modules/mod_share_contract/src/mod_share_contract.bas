Namespace mod_share_contract

   Class TShareContract
      Inherits TPortableExe
      Private _exeBase64 As String = ""

      Title As String
      Text As String
      Files As StringList

      Sub New()
         MyBase.New()
         me.ExeBase64 = me._exeBase64
         me.ExeFileName = "mod_share_contract_winrt.exe"
         me.Title = "Compartilhamento do ERP"
         me.Text = ""
         me.Files = New StringList()
      End Sub

      Function IsSupported() As Boolean
         IsSupported = WinAPI.OS.IsWindows10() Or WinAPI.OS.IsWindows11()
      End Function

      Sub Share(pParentHandle As Integer)
         If Not me.IsSupported() Then
            Throw New Exception("Esse recurso só está disponível no Windows 10/11, processo abortado.")
         End If

         If pParentHandle = 0 Then
            print("TShareContract.Share requer o handle da janela pai.")
            Exit Sub
         End If

         me.EnsureExe()
         Dim args As String = "-hwnd " & CStr(pParentHandle)
         If Trim(me.Title) <> "" Then
            args = args & " -title " & me.QuoteArg(me.Title)
         End If
         If Trim(me.Text) <> "" Then
            args = args & " -text " & me.QuoteArg(me.Text)
         End If
         For Each filePath As String In me.Files
            If Trim(filePath) <> "" Then
               args = args & " -file " & me.QuoteArg(filePath)
            End If
         Next

         If me.StartProcess(args) Then
            While me.IsRunning()
               Sleep(2)
               Forms.ProcessMessages()
            End While
         End If
         me.StopProcess("")
      End Sub

      Sub Free()
         If Assigned(me.Files) Then
            me.Files.Free()
         End If
         MyBase.Free()
      End Sub

   End Class

End Namespace